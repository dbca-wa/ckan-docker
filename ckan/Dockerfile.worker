# This image is entirely a DBCA addition — upstream ckan-docker dropped the bundled
# supervisor/worker. It layers the job-worker role on top of the built CKAN image,
# supplied as the named build context `ckan`:
#   compose -> build.additional_contexts (ckan: service:ckan[-dev])
#   CI/buildx -> build-contexts: ckan=docker-image://<ckan-tag>
FROM ckan

# Run setup as root (config-tool, COPY and chown below need it); back to ckan at the end.
USER root

ENV CKAN_WORKER=true
# Override the default CKAN config plugins to only use the ones we need for the worker.
# Keep this in sync with dbca.ini's enabled set: dbca is temporarily disabled for the
# CKAN 2.11 upgrade (see dbca.ini) — loading it here would otherwise crash `ckan db init`
# in prerun (dbca_logs.exists() bound-metadata error). Re-add in Phase 3.
ENV CKAN__PLUGINS="activity datastore xloader pages scheming_datasets doi qa archiver report image_view text_view datatables_view pdf_view geo_view shp_view officedocs_view envvars"
RUN ckan config-tool $CKAN_INI "ckan.plugins = ${CKAN__PLUGINS}"

## Supervisor config (supervisor itself is installed via dbca_requirements.sh).
## Trailing slash keeps the dir target a directory for the multiple conf files.
RUN mkdir -p /etc/supervisord.d
COPY supervisor/ckan_*.conf /etc/supervisord.d/
COPY supervisor/supervisord.conf /etc/supervisord.conf

## Cron jobs scripts
COPY setup/dbca_logs_maintenance.sql $APP_DIR

# Set ownership for the ckan runtime user. site-packages is inherited already
# owned from the base ckan image (the worker installs nothing there), so only the
# files this stage adds need chowning.
RUN chown -R ckan:ckan-sys $APP_DIR && \
    chown -R ckan:ckan-sys /etc/supervisord.d && \
    chmod -x $APP_DIR/dbca_logs_maintenance.sql

# Set the default user to ckan
USER ckan
